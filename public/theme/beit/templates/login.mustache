{{!
    @template theme_beit/login

    BEIT login page — full-screen gradient, centered card.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="beit-login-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <div class="beit-login-bg">
        <div class="beit-login-card">
            <div class="beit-login-card-header">
                <div class="beit-login-icon">
                    <i class="fa fa-graduation-cap" aria-hidden="true"></i>
                </div>
                <h1 class="beit-login-title">{{sitename}}</h1>
                <p class="beit-login-subtitle">Connectez-vous pour accéder à la plateforme</p>
            </div>
            {{{ maincontent }}}
        </div>
    </div>

</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
