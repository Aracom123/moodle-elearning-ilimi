            WHERE action = :action
            AND timecreated > :timecreated";

        // Getting access log.
        $params = array (
            "action" => "viewed",
            "timecreated" => time() - LOCAL_SITEREPORT_ONEYEAR
        );

        if (defined('EDWISER_REPORTS_WEB_SCRIPT')) {
            // Increase memory limit.
            raise_memory_limit(MEMORY_UNLIMITED);
        }
        $this->progress->start_progress();
