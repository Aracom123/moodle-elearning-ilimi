    position: absolute;
    left: 0;
    bottom: 0;
    right: 0;
    padding: 0 0.3em;
    font-size: 9px;
    font-weight: 500;
}

.fi:before {
    left: 0;
    top: 0;
    height: 100%;
    background-color: #007bff;
    right: 7px;
}

.fi:after {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 7px 0 0 7px;
    border-color: transparent transparent transparent #66b0ff;
    top: 0;
    right: 0;
