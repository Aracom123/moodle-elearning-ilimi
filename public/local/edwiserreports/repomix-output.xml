     */
    public $insights = array();

    /**
     * Constructor
     */
    public function __construct() {
        $upgradelink = '';
        if (is_siteadmin()) {
            $upgradelink = UPGRADE_URL;
        }
        $this->insights = array(
            'newregistrations' => array(
                'icon' => $this->image_icon('registration'),
                'title' => get_string('newregistrations', 'local_edwiserreports'),
